# Configuración de i3wm con esquema de colores basado en Batman Beyond

# Gaps
gaps inner 20

# Mod key
set $mod Mod4

# Fuentes
font pango:monospace 8

# Resolución de pantalla
exec_always --no-startup-id xrandr --output DP-4 --mode 2560x1440 --rate 179.88 --output HDMI-0 --mode 1920x1080 --rate 74.97

# Autostart de aplicaciones
exec --no-startup-id dex --autostart --environment i3
# nm-applet is started by dex via /etc/xdg/autostart/nm-applet.desktop
# Notificaciones (dunst, tema Batman Beyond en ~/.config/dunst/dunstrc)
exec --no-startup-id dunst
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock -i ~/Pictures/wallpapers/i3lock-batman.png --nofork

# Política de inactividad: bloquear tras 2h de inactividad real, sin apagar monitores.
# El bloqueo NO detiene procesos (los agentes siguen corriendo); logind no suspende sola.
exec_always --no-startup-id xset s 7200 600
exec_always --no-startup-id xset -dpms

# Modo agentes: alterna el autolock (ON 2h <-> OFF). Bloqueo manual siempre en $mod+l
bindsym $mod+Ctrl+l exec --no-startup-id ~/.config/i3/scripts/toggle-idle.sh

# Notificaciones (dunst): historial y descartar todo
bindsym $mod+n exec --no-startup-id dunstctl history-pop
bindsym $mod+Shift+n exec --no-startup-id dunstctl close-all

# Configuración de volumen
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle

# Brillo
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-
bindsym XF86MonBrightnessUp exec brightnessctl set +10%

# Comportamiento de ventanas flotantes
floating_modifier $mod
tiling_drag modifier titlebar

# Atajos de teclado
bindsym $mod+Return exec alacritty
bindsym $mod+t exec kitty --class "kitty-floating"
bindsym $mod+q kill

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Screenshots (maim)
bindsym $mod+Print exec --no-startup-id maim -s ~/Pictures/screenshots/$(date +%Y%m%d-%H%M%S).png
bindsym $mod+Shift+Print exec --no-startup-id maim ~/Pictures/screenshots/$(date +%Y%m%d-%H%M%S).png
bindsym $mod+d exec --no-startup-id ~/.config/rofi/launchers/type-7/launcher.sh
bindsym $mod+l exec --no-startup-id ~/.config/rofi/powermenu/type-6/powermenu.sh

# Movimiento y disposición de ventanas
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+Tab workspace back_and_forth

# Espacios de trabajo
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# Resize window mode
mode "resize" {
    # These bindings trigger as soon as you enter the resize mode
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    # same bindings, but for the arrow keys
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt

    # back to normal: Enter or Escape or $mod+r
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

# Enter resize mode
bindsym $mod+r mode "resize"

# Recargar configuración
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Do you really want to exit i3?' -B 'Yes, exit i3' 'i3-msg exit'"

# Configuración de bordes
for_window [class=".*"] border pixel 4

# Colores inspirados en Batman Beyond
set $base           #000000  # Negro base
set $surface        #1a1a1a  # Gris oscuro
set $overlay        #262626  # Gris más claro
set $muted          #404040  # Gris intermedio
set $subtle         #666666  # Gris claro
set $text           #ffffff  # Blanco
set $love           #ff0000  # Rojo neón
set $highlightlow   #0f0f0f  # Casi negro
set $highlightmed   #ff3333  # Rojo suave
set $highlighthigh  #ff4d4d  # Rojo brillante

# Temas para ventanas
client.focused           $love     $base $text  $love      $love
client.focused_inactive  $subtle   $base $text  $muted     $surface
client.unfocused         $subtle   $base $text  $overlay   $overlay
client.urgent            $love     $base $text  $highlightmed $love
client.placeholder       $base     $base $text  $overlay   $overlay

# Auto-place apps on workspaces
assign [class="Spotify"] $ws3
assign [class="(?i)firefox"] $ws2
assign [class="Thunderbird"] $ws4
assign [class="discord"] $ws5

# Gaps pulidos
gaps outer 5
smart_gaps on

# Fondo de pantalla
exec_always feh --bg-fill ~/Pictures/wallpapers/pandemonium.jpg

# Otros programas
# picom is started by dex via /etc/xdg/autostart/picom.desktop (single instance)
exec_always --no-startup-id ~/.config/polybar/launch.sh
